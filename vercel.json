{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/post/:slug",
      "destination": "/api/post?slug=:slug"
    },
    {
      "source": "/news",
      "destination": "/news.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/about.html"
    },
    {
      "source": "/tsr-score",
      "destination": "/tsr-score-calculator.html"
    },
    {
      "source": "/tsr-score.html",
      "destination": "/tsr-score-calculator.html"
    },
    {
      "source": "/tournaments",
      "destination": "/tournaments.html"
    },
    {
      "source": "/tournament-index",
      "destination": "/tournaments.html"
    },
    {
      "source": "/media",
      "destination": "/media.html"
    },
    {
      "source": "/hosted-games",
      "destination": "/hosted-games.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
