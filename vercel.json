{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/about.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/about.html"
    },
    {
      "source": "/post/:slug",
      "destination": "/article.html?slug=:slug"
    }
  ]
}